{
  "framework": "vite",
  "installCommand": "pnpm install && pnpm approve-builds --allow @tailwindcss/oxide esbuild",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://edgeai-blockchain-node.fly.dev/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
